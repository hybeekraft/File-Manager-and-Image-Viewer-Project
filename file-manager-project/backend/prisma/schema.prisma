generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model File {
  id           String   @id @default(cuid())
  originalName String
  storedName   String   @unique
  mimeType     String
  size         Int
  path         String
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([mimeType])
}
